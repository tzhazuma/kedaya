{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "小程序：类型检查",
      "type": "shell",
      "command": "npm run typecheck -w @kedaya/miniapp",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "小程序：构建",
      "type": "shell",
      "command": "npm run build:weapp -w @kedaya/miniapp",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "小程序：真实模拟器冒烟",
      "type": "shell",
      "command": "npm run smoke:weapp -w @kedaya/miniapp",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
