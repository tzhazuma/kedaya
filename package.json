{
  "name": "kedaya",
  "version": "0.1.0",
  "private": true,
  "description": "可达鸭 · 上海科技大学统一校园服务平台（微信小程序 / Web / NestJS）",
  "packageManager": "npm@10.9.9",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev:web": "npm run dev -w @kedaya/web -- --port 3001",
    "dev:weapp": "npm run dev:weapp -w @kedaya/miniapp",
    "build:weapp": "npm run build:weapp -w @kedaya/miniapp",
    "tokens": "node packages/design-tokens/scripts/generate.mjs",
    "check:nutrition-imports": "node scripts/check-nutrition-imports.mjs",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.8",
    "typescript": "5.9.3"
  }
}
