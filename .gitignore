# ---- deps ----
node_modules/
.node_modules-install-backup-*/
.pnp/
.pnp.js

# ---- build output ----
.turbo/
dist/
build/
.next/
out/
*.tsbuildinfo

# ---- 例外：design-tokens 的派生产物必须提交 ----
# 小程序与 Web 在无构建步骤的情况下直接消费这些文件
!packages/design-tokens/dist/

# ---- env ----
.env
.env.local
.env.*.local
!.env.example

# ---- 微信小程序 / Taro ----
apps/miniapp/dist/
apps/miniapp/.temp/
apps/miniapp/.rn_temp/
project.private.config.json

# ---- 本地上传的媒体文件（MEDIA_STORAGE=local 的落盘目录）----
.media/

# ---- 编辑器 / 系统 ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ---- 日志 ----
*.log
npm-debug.log*
yarn-error.log*
logs/

# ---- 构建工具缓存（不要提交）----
.swc/
.taro-cache/
.cache/
*.swc/
**/.swc/

# ---- 临时脚手架脚本产物 ----
apps/*/.turbo/

# ---- Python 字节码缓存（工具脚本产生的，不要提交）----
__pycache__/
*.pyc
*.pyo

# ---- Flutter / Android 构建产物 ----
apps/mobile/build/
apps/mobile/.dart_tool/
apps/mobile/.idea/
apps/mobile/android/.gradle/
apps/mobile/android/local.properties
apps/mobile/**/GeneratedPluginRegistrant.*
