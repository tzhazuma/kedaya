// 可达鸭 · Prisma schema（PostgreSQL 16）
// 冻结契约：docs/architecture/00-FROZEN-CONTRACT.md §5（两级身份）、§6.1（金额整数分）、§9（隐私合规）
//
// 全局约定
//   · 主键统一 cuid()，便于分页游标直接复用主键
//   · 金额字段一律 Int，单位 **分**（契约 §6.1：`amountFen: number`），禁止 Float/Decimal
//   · 时间一律 DateTime（UTC），由 API 层序列化为 ISO-8601
//   · 敏感表在模型上方用 `/// 访问域` 注释标明，Prisma 会把这些注释带进生成的客户端文档

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // 注意（Prisma 7 破坏性变更）：schema 里**不再允许**写 `url = env("DATABASE_URL")`。
  // 连接串现在有两个来源：
  //   · Migrate / introspect 等 CLI 命令 → prisma.config.ts 的 `datasource.url`
  //   · 运行时 PrismaClient          → driver adapter（见 src/prisma/prisma.service.ts）
}

/* ================================================================== *
 * 1. 身份域（契约 §5）—— 两级模型，物理分离
 * ================================================================== */

/// KedaYa 自有账户。**不**存放任何校园系统凭据。
model User {
  id           String  @id @default(cuid())
  displayName  String
  avatarUrl    String?
  department   String?
  /// 匿名身份与实名身份解耦：本账号是否被允许使用匿名handle（契约 §9）
  anonEnabled  Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// 自建账号凭据（邮箱 + 密码）。仅密码登录方式存在时为 null（例如纯 CAS 账号）
  credential     UserCredential?
  identities     AuthIdentity[]
  campusBindings CampusBinding[]
  consents       Consent[]
  auditLogs      AuditLog[]
  profileSetting ProfileSetting?
  schedule       ScheduleCourse[]
  cardTxns       CampusCardTransaction[]
  notifications  Notification[]
  portrait       AiPortraitProfile?
  appointments   WellbeingAppointment[]
  refreshSessions RefreshSession[]
  /// 用户在各模块里发布的内容（所有权判定的唯一依据）
  fleaItems      FleaItem[]
  errandTasks    ErrandTask[]
  errandRuns     ErrandTask[] @relation("ErrandRunner")
  buddyGroups    BuddyGroup[]
  buddyMembers   BuddyMember[]
  lostFoundItems LostFoundItem[]
  forumPosts     ForumPost[]
  forumReplies   ForumReply[]

  @@index([createdAt])
}

/// 自建账号凭据：邮箱 + 密码（**与 CAS 身份层物理分离**）。
///
/// 访问域：identity
/// 硬规则：
///   1. 只存 `scrypt` 派生的哈希（含随机盐与成本参数），绝不落明文或可逆密文；
///   2. 连续失败次数与锁定时间写在本表，锁定判定由服务层执行；
///   3. 本表**不**参与 `AuthPort`（第一级 CAS 端口）—— 它是第二条独立的登录方式，
///      两条路径最终都收敛到同一个 KedaYa `User`。
model UserCredential {
  id                String    @id @default(cuid())
  userId            String    @unique
  /// 规范化小写邮箱；唯一索引用于「邮箱即账号」
  email             String    @unique
  /// scrypt 哈希，格式 scrypt$N$r$p$saltB64$hashB64
  passwordHash      String
  /// active | locked | disabled
  status            String    @default("active")
  failedAttempts    Int       @default(0)
  lockedUntil       DateTime?
  passwordChangedAt DateTime  @default(now())
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([status])
}

/// 一次性验证码（注册 / 找回密码 / 更换密码）。
///
/// 访问域：identity
/// 硬规则：
///   1. 只存哈希，验证码明文仅出现在发信内容里；
///   2. 有 TTL、最大尝试次数与冷却时间，全部在服务层强制；
///   3. 消费后写 `consumedAt`，不物理删除，便于审计与防重放。
model VerificationCode {
  id         String    @id @default(cuid())
  /// 目标（规范化小写邮箱）
  target     String
  /// register | reset-password | change-password
  purpose    String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([target, purpose, createdAt])
  @@index([expiresAt])
}

/// 刷新令牌会话：让 refreshToken **可撤销、可轮换**（登出即失效）。
///
/// 访问域：identity
/// 只存 `sha256(token)`，不存令牌本身；轮换时旧行立即 `revokedAt`。
model RefreshSession {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

/// 第一级 · 身份层。上科大统一身份认证（CAS / Egate OAuth）的映射结果。
///
/// 访问域：identity
/// 硬规则（契约 §5）：本表**只**回答"你是谁"。绝不包含任何校园系统的
/// cookie / session / tgc —— 那些属于 CampusBinding（第二级）。
model AuthIdentity {
  id         String @id @default(cuid())
  userId     String
  /// 上游提供方：SHTU_CAS | SHTU_EGATE
  provider   String
  /// 上游唯一标识（CAS 的学号 / OAuth 的 sub）
  externalId String
  /// 上科大邮箱（*@shanghaitech.edu.cn）
  email      String?
  realName   String?
  department String?
  /// 第一级登录时间。注意：这不代表任何校园系统已绑定。
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([userId])
}

/// 第二级 · 能力层。第三方校园系统绑定。
///
/// 访问域：campus-binding（加密字段，仅 CampusSessionPort 可解密）
/// 硬规则（契约 §5）：
///   1. 本表与身份层**物理分离**，任何校园 session 都不得上抛为身份；
///   2. `encryptedSession` 为 AES-256-GCM 密文，密钥在环境变量里，绝不落库；
///   3. 可以"已登录但未绑定" —— 此时 campus 能力返回 CAMPUS_BINDING_REQUIRED。
model CampusBinding {
  id         String @id @default(cuid())
  userId     String
  /// 目标校园系统：EGATE | CPDAILY | JWC | CARD
  platform   String
  /// AES-256-GCM 加密后的 session cookie 引用（密文，非明文）
  encryptedSession String
  /// session 的不可逆指纹，仅用于判断"是否需要重新绑定"，不含明文
  sessionFingerprint String?
  /// 该绑定被授权的能力范围
  scopes     String[]
  status     String   @default("active")
  expiresAt  DateTime
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([userId, status])
  @@index([expiresAt])
}

/// 敏感模块二次同意（契约 §9）。可随时撤回，撤回后保留历史行（revokedAt 非空）。
///
/// 访问域：consent
/// 注意：auth / campus-card 虽是 high 敏感但**不设同意门**，
/// 判定规则来自 @kedaya/contracts 的 `requiresConsent`，不在本表硬编码。
model Consent {
  id        String    @id @default(cuid())
  userId    String
  /// 契约 §4 的模块 id：wellbeing | dorm-harmony | ai-portrait
  module    String
  /// 用户同意的协议版本，便于协议变更后重新征求
  version   String    @default("v1")
  grantedAt DateTime  @default(now())
  /// 非空表示已撤回
  revokedAt DateTime?
  ip        String?
  ua        String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
  @@index([userId, module, revokedAt])
}

/// 审计日志（契约 §9：敏感模块读写全部落审计）。
///
/// 访问域：audit（只写不删；仅合规角色可读）
model AuditLog {
  id         String   @id @default(cuid())
  /// 操作者。匿名操作时为 null，用 actorType 区分
  actorId    String?
  /// user | anonymous | system | service
  actorType  String   @default("user")
  /// 领域动作，如 wellbeing.appointment.create
  action     String
  /// 资源类型，如 WellbeingAppointment
  resource   String
  resourceId String?
  /// 契约 §4 模块 id
  module     String?
  ip         String?
  ua         String?
  at         DateTime @default(now())
  metadata   Json?

  user User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([module, at])
  @@index([actorId, at])
  @@index([resource, resourceId])
}

/* ================================================================== *
 * 2. 业务模块表（契约 §4.1，14 个）
 * ================================================================== */

/// 拼单 · groupbuy（低敏感）
model GroupbuyOrder {
  id           String   @id @default(cuid())
  ownerId      String
  title        String
  description  String?
  category     String
  /// 成团所需人数
  targetCount  Int
  /// 单价，**分**
  unitPriceFen Int
  status       String   @default("open")
  deadline     DateTime
  pickupSpot   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members GroupbuyMember[]

  @@index([status, deadline])
  @@index([category])
}

/// 拼单参团记录
model GroupbuyMember {
  id       String   @id @default(cuid())
  orderId  String
  userId   String
  quantity Int      @default(1)
  /// 已付金额，**分**
  paidFen  Int      @default(0)
  role     String   @default("member")
  joinedAt DateTime @default(now())

  order GroupbuyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, userId])
  @@index([userId])
}

/// 偷外卖 · takeout-guard（中敏感，支持匿名）
model TakeoutReport {
  id          String   @id @default(cuid())
  /// 实名举报者；匿名举报时为 null
  reporterId  String?
  /// 匿名 handle，与实名身份解耦存储（契约 §9）
  anonHandle  String?
  orderNo     String
  place       String
  happenedAt  DateTime
  detail      String?
  evidenceUrl String?
  status      String   @default("reported")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, happenedAt])
  @@index([anonHandle])
}

/// 跳蚤 · flea-market（低敏感）
model FleaItem {
  id          String   @id @default(cuid())
  sellerId    String
  title       String
  description String?
  /// 价格，**分**
  priceFen    Int
  category    String
  /// new | like-new | good | fair
  condition   String   @default("good")
  campusSpot  String?
  /// 图片地址。**只存本平台上传的地址**（见 common/media/media-url.ts 的白名单），
  /// 且上传时已剥离 EXIF GPS（契约 A2.5）。
  imageUrls   String[] @default([])
  status      String   @default("on-sale")
  /// 被预定/售出后置位，便于"我的发布"展示
  reservedById String?
  soldAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seller User @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([status, category])
  @@index([priceFen])
  @@index([sellerId, status])
}

/// 宿舍矛盾 · dorm-harmony（**高敏感**）
///
/// 访问域：dorm-harmony
/// 契约 §9：匿名调解，禁止进入通用画像；ai-portrait 不得读取本表。
///
/// 匿名与「可追踪」并存的做法（重要）：
///   本表**没有**指向 `User` 的外键（防止实名关联），
///   用户在提交时会拿到一次性的 `trackCode` 明文，
///   服务端只存 `trackCodeHash`。后续查询/追加留言都必须出示该 code，
///   因此"能追踪自己的案子"与"服务端不知道案子属于谁"可以同时成立。
model DormHarmonyCase {
  id            String   @id @default(cuid())
  /// 匿名 handle —— 与实名 User 无外键，刻意解耦
  anonHandle    String
  /// 追踪码的哈希（明文只在提交响应里出现一次）
  trackCodeHash String?
  building      String
  topic         String
  detail        String?
  status        String   @default("submitted")
  /// 调解员（宿管/辅导员），未介入时为 null
  mediatorId    String?
  /// 期望的解决方式：talk | mediation | rule | other
  expectation   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages DormHarmonyMessage[]

  @@index([status, building])
  @@index([anonHandle])
}

/// 宿舍矛盾调解留言（匿名线索）。高敏感：只按 caseId 关联。
model DormHarmonyMessage {
  id         String   @id @default(cuid())
  caseId     String
  /// student | mediator
  fromRole   String   @default("student")
  anonHandle String?
  body       String
  createdAt  DateTime @default(now())

  case DormHarmonyCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
}

/// 跑腿 · errand（低敏感）
model ErrandTask {
  id          String   @id @default(cuid())
  requesterId String
  /// 接单者，未接单为 null
  runnerId    String?
  title       String
  detail      String?
  /// 悬赏，**分**
  rewardFen   Int
  fromPlace   String
  toPlace     String
  deadline    DateTime
  status      String   @default("open")
  /// 接单时间 / 送达时间，用于超时判定与「我的跑腿」排序
  acceptedAt  DateTime?
  deliveredAt DateTime?
  settledAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User  @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  runner    User? @relation("ErrandRunner", fields: [runnerId], references: [id], onDelete: SetNull)

  @@index([status, deadline])
  @@index([rewardFen])
  @@index([requesterId, status])
  @@index([runnerId, status])
}

/// 找搭子 · buddy（低敏感）
model BuddyGroup {
  id         String   @id @default(cuid())
  ownerId    String
  activity   String
  title      String
  description String?
  campusSpot String
  startsAt   DateTime
  capacity   Int
  status     String   @default("recruiting")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner   User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members BuddyMember[]

  @@index([status, startsAt])
  @@index([activity])
}

/// 搭子成员（组队关系）。与 BuddyGroup 分离，便于精确控制容量与退出。
model BuddyMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  /// owner | member
  role     String   @default("member")
  joinedAt DateTime @default(now())

  group BuddyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

/// 失物招领 · lost-found（低敏感）
model LostFoundItem {
  id          String   @id @default(cuid())
  reporterId  String
  /// lost | found
  kind        String
  title       String
  description String?
  place       String
  happenedAt  DateTime
  contactHint String?
  /// 图片地址（同 FleaItem.imageUrls：仅本平台地址，已剥离 EXIF GPS）
  imageUrls   String[] @default([])
  status      String   @default("open")
  /// 认领/归还后置位（closed | claimed）
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([kind, status])
  @@index([happenedAt])
  @@index([reporterId, status])
}

/// 食堂营养 · canteen（低敏感）
model CanteenDish {
  id           String   @id @default(cuid())
  canteen      String
  name         String
  caloriesKcal Int
  proteinG     Int
  fatG         Int
  carbG        Int
  /// 价格，**分**
  priceFen     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([canteen])
  @@index([caloriesKcal])
}

/// 论坛 · forum（中敏感，支持匿名）
model ForumPost {
  id         String   @id @default(cuid())
  board      String
  authorId   String?
  anonHandle String?
  title      String
  body       String
  /// 图片地址（同 FleaItem.imageUrls：仅本平台地址，已剥离 EXIF GPS）
  imageUrls  String[] @default([])
  status     String   @default("published")
  /// 置顶/加精等治理位（0 = 普通）
  pinnedRank Int      @default(0)
  replyCount Int      @default(0)
  lastReplyAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author  User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  replies ForumReply[]

  @@index([board, status, createdAt])
  @@index([anonHandle])
  @@index([authorId])
}

/// 论坛回复
model ForumReply {
  id         String   @id @default(cuid())
  postId     String
  authorId   String?
  anonHandle String?
  body       String
  status     String   @default("published")
  createdAt  DateTime @default(now())

  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt])
}

/// AI 校园画像 · ai-portrait（**高敏感**）
///
/// 访问域：ai-portrait
/// 契约 §9 数据最小化：本表**不得**由 wellbeing / dorm-harmony 的数据派生。
/// `explain` 存放可解释性字段，`enabled` 对应用户可关闭开关。
model AiPortraitProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  /// 画像标签（可解释、可关闭）
  traits    Json
  /// 每个标签的推导来源，供用户查看"为什么给我推这个"
  explain   Json
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// 心理治疗 · wellbeing（**最高敏感**）
///
/// 访问域：wellbeing
/// 契约 §9：
///   · 必须二次同意（Consent 表），否则 CONSENT_REQUIRED；
///   · 读写全部落 AuditLog；
///   · 必须提供危机干预热线出口，且不可被埋进二级菜单；
///   · 数据不进入通用画像。
model WellbeingAppointment {
  id         String   @id @default(cuid())
  userId     String
  counselor  String
  slotAt     DateTime
  /// online | onsite
  mode       String   @default("onsite")
  status     String   @default("requested")
  /// 最小化采集：仅存用户主动填写的诉求摘要
  note       String?
  /// 触发危机干预流程的标记
  crisisFlag Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, slotAt])
  @@index([status])
}

/// 常见问题 · faq（低敏感）
model FaqEntry {
  id           String   @id @default(cuid())
  question     String
  answer       String
  category     String
  tags         String[]
  helpfulCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
}

/// TechPie 整合 · techpie（中敏感）
/// 模型名用 Link 而不是 Service，避免与生成的 TechpieService 类名冲突。
model TechpieLink {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  category  String
  url       String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, status])
}

/// 猫鸟黑天鹅 · wildlife（低敏感）
model WildlifeSpot {
  id         String   @id @default(cuid())
  species    String
  place      String
  lat        Float
  lng        Float
  note       String?
  reportedBy String?
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([species, status])
}

/* ================================================================== *
 * 3. 基础模块表（契约 §4.2，5 个）
 * ================================================================== */

/// 课表 · schedule（中敏感）
model ScheduleCourse {
  id         String   @id @default(cuid())
  userId     String
  term       String
  courseName String
  teacher    String?
  location   String?
  /// 1=周一 … 7=周日
  weekday    Int
  /// 第几节开始 / 结束（1..12）
  startSlot  Int
  endSlot    Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, term])
  @@index([term, weekday])
}

/// 校园卡 · campus-card（**高敏感**，需审计 + 最小采集，但**不设同意门**）
///
/// 访问域：campus-card
/// 契约 §9：登录/开卡这个行为本身就是同意，不叠二次同意门。
/// 真实流水必须经 CampusSessionPort（第二级）拉取，未绑定 → CAMPUS_BINDING_REQUIRED。
model CampusCardTransaction {
  id              String   @id @default(cuid())
  userId          String
  /// 金额，**分**。direction 决定正负语义
  amountFen       Int
  /// in | out
  direction       String
  merchant        String
  happenedAt      DateTime
  balanceAfterFen Int
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, happenedAt])
}

/// 我的 · profile（中敏感）—— 隐私开关集中存放
model ProfileSetting {
  id               String   @id @default(cuid())
  userId           String   @unique
  showRealName     Boolean  @default(false)
  /// 契约 §9：画像必须"可关闭"
  allowAiPortrait  Boolean  @default(false)
  allowWellbeing   Boolean  @default(false)
  allowDormHarmony Boolean  @default(false)
  themeMode        String   @default("system")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// 通知 · notifications（低敏感）
model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  /// inapp | wechat-subscribe | push
  channel   String    @default("inapp")
  /// 业务来源：groupbuy | errand | flea-market | forum | campus-card | schedule | system …
  /// 前端据此选图标与分组（不解析 title 猜来源）
  source    String    @default("system")
  /// 点击后跳转的小程序页面路径（取自 @kedaya/contracts 的 MINIAPP_PAGES）。
  /// 允许为空 —— 有些通知只是"告知"，没有可跳转的目标，前端必须能处理这种情况。
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
}
