{
  "name": "@kedaya/miniapp",
  "version": "0.1.0",
  "private": true,
  "description": "可达鸭 · 微信小程序（主端）—— Taro 4.3 + React 19 + TypeScript 5.9",
  "scripts": {
    "tokens:scss": "node scripts/generate-tokens-scss.mjs",
    "dev:weapp": "npm run tokens:scss && taro build --type weapp --watch",
    "build:weapp": "npm run tokens:scss && taro build --type weapp",
    "dev:h5": "npm run tokens:scss && taro build --type h5 --watch",
    "build:h5": "npm run tokens:scss && taro build --type h5",
    "build": "npm run build:weapp",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "clean": "rm -rf dist .temp .swc"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.0",
    "@kedaya/contracts": "*",
    "@kedaya/shared": "*",
    "@taroify/core": "^1.0.6",
    "@taroify/icons": "^1.0.6",
    "@tarojs/components": "4.3.0",
    "@tarojs/helper": "4.3.0",
    "@tarojs/plugin-framework-react": "4.3.0",
    "@tarojs/plugin-platform-h5": "4.3.0",
    "@tarojs/plugin-platform-weapp": "4.3.0",
    "@tarojs/react": "4.3.0",
    "@tarojs/router": "4.3.0",
    "@tarojs/runtime": "4.3.0",
    "@tarojs/taro": "4.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-react": "^7.24.1",
    "@eslint/js": "^10.0.0",
    "@kedaya/design-tokens": "*",
    "@tarojs/cli": "4.3.0",
    "@tarojs/webpack5-runner": "4.3.0",
    "@types/node": "^26.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "babel-preset-taro": "4.3.0",
    "eslint": "10.12.0",
    "sass": "^1.105.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "5.0.5"
  }
}
